meta {
  name: Registration
  type: http
  seq: 1
}

post {
  url: {{host_api}}/api/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "first_name": "ssss",
    "last_name": "Александрович",
    "patronymic": "ssss",
    "login": "ssssss",
    "phone": "+88005553535",
    "email": "example@example.com",
    "password": "QWEasd123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
